# Copy to .env and set database/JWT secrets before docker compose up --build --wait.
COMPOSE_PROJECT_NAME=corporate-catering
HTTP_PORT=8080
ORDER_DB_NAME=orders
ORDER_DB_USER=orders
ORDER_DB_PASSWORD=
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=
# Physical database identity is retained for existing Kitchen volumes.
KITCHEN_DB_USER=production
KITCHEN_DB_PASSWORD=

IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=
# Base64 of at least 32 cryptographically random bytes, e.g. openssl rand -base64 32.
JWT_SECRET_BASE64=
JWT_ISSUER=corporate-catering-identity
JWT_ACCESS_TTL=15m
JWT_CLOCK_SKEW=30s
# Required only on an empty Identity DB. Remove after the first bootstrap.
IDENTITY_BOOTSTRAP_LOGIN=
IDENTITY_BOOTSTRAP_PASSWORD=

# Internal RSA JWT: Base64 PKCS8 private key (Identity only), X509 public key (validators).
INTERNAL_JWT_PRIVATE_KEY_BASE64=
INTERNAL_JWT_PUBLIC_KEY_BASE64=
# Random 32-byte Base64 credential shared only by Gateway and Identity.
GATEWAY_EXCHANGE_SECRET=
